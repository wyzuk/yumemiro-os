{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/yumemiro.logo",
        "type": "file",
        "color": {
            "1": "magenta",
            "2": "purple"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " 🌸 "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS          ",
            "keyColor": "38;2;216;180;254"
        },
        {
            "type": "kernel",
            "key": "Kernel      ",
            "keyColor": "38;2;244;114;182"
        },
        {
            "type": "uptime",
            "key": "Uptime      ",
            "keyColor": "38;2;192;132;252"
        },
        {
            "type": "wm",
            "key": "Desktop (WM)",
            "keyColor": "38;2;244;114;182"
        },
        {
            "type": "shell",
            "key": "Shell       ",
            "keyColor": "38;2;216;180;254"
        },
        {
            "type": "terminal",
            "key": "Terminal    ",
            "keyColor": "38;2;192;132;252"
        },
        {
            "type": "cpu",
            "key": "CPU         ",
            "keyColor": "38;2;244;114;182"
        },
        {
            "type": "gpu",
            "key": "GPU         ",
            "keyColor": "38;2;216;180;254"
        },
        {
            "type": "memory",
            "key": "Memory      ",
            "keyColor": "38;2;192;132;252"
        },
        "break",
        "colors"
    ]
}
